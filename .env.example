# Copy to .env.local and fill in from `npx convex dev` output
# (.env.local is gitignored — never commit real values).

# HTTP actions URL of the Convex deployment — what the player talks to.
# Required for both local dev and the GitHub Pages build (repo variable CONVEX_SITE_URL).
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Client URL of the Convex deployment. Only needed if you add queries/mutations
# and mount a ConvexReactClient (repo variable CONVEX_URL).
VITE_CONVEX_URL=https://your-deployment.convex.cloud
